{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/benquemax/henxels/main/henxels/schema/henxels.schema.json",
  "title": "henxels contract",
  "description": "A whiteboard list of rules (henxels). Each henxel is a sentence plus statements that must all pass.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "imports": {
      "description": "Modules that register custom statements (also auto-loaded from henxels_checks.py / .henxels/).",
      "type": "array",
      "items": { "type": "string" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "henxels": {
      "description": "The rule list. Each item is one henxel.",
      "type": "array",
      "items": { "$ref": "#/$defs/henxel" }
    }
  },
  "$defs": {
    "settings": {
      "description": "Behaviours (not tests): protections + tuning knobs.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ask_me_before_staging": { "type": "boolean" },
        "confirm_before_push": { "type": "boolean" },
        "confirm_before_deleting": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": { "over_lines": { "type": "integer", "minimum": 0 } }
            }
          ]
        },
        "warn_about_similar_files": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "above": { "type": "number", "minimum": 0, "maximum": 1 },
                "ignore": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        }
      }
    },
    "scalarOrList": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "casingValue": {
      "type": "string",
      "enum": ["snake_case", "kebab-case", "camelCase", "PascalCase", "SCREAMING_SNAKE_CASE", "any"]
    },
    "henxel": {
      "type": "object",
      "description": "One rule: a sentence (henxel:) + an optional in:/level: + statements.",
      "properties": {
        "henxel": { "type": "string", "description": "the rule, in plain words (also the failure message)" },
        "rule": { "type": "string" },
        "must": { "type": "string" },
        "description": { "type": "string" },
        "in": { "$ref": "#/$defs/scalarOrList", "description": "where this henxel applies: ./docs = that folder, ./docs/* = recursively, ./ = repo root, ./* = whole repo (default)" },
        "level": { "type": "string", "enum": ["block", "warn"] },

        "filename_casing": {
          "description": "file names use this naming convention (list = any of)",
          "oneOf": [{ "$ref": "#/$defs/casingValue" }, { "type": "array", "items": { "$ref": "#/$defs/casingValue" } }]
        },
        "allowed_filetypes": { "$ref": "#/$defs/scalarOrList", "description": "every file is one of these extensions/globs (list = OR)" },
        "filename_matches_regex": { "$ref": "#/$defs/scalarOrList" },
        "required_frontmatter": { "$ref": "#/$defs/scalarOrList", "description": "markdown declares these keys (list = all)" },
        "required_files": { "$ref": "#/$defs/scalarOrList" },
        "required_subfolders": { "$ref": "#/$defs/scalarOrList" },
        "only_these_subfolders": { "$ref": "#/$defs/scalarOrList" },
        "forbidden_files": { "$ref": "#/$defs/scalarOrList" },
        "forbidden_subfolders": { "$ref": "#/$defs/scalarOrList" },
        "must_not_exist": { "type": "boolean" },
        "markdown_lint": { "type": "boolean" },
        "markdown_links_absolute": { "type": "boolean" },
        "well_formed_statements": { "type": "boolean" },
        "run_before_commit": { "$ref": "#/$defs/scalarOrList" },
        "run_before_push": { "$ref": "#/$defs/scalarOrList" }
      },
      "additionalProperties": true
    }
  }
}
