{
  "name": "henxels",
  "version": "0.2.0",
  "description": "A repo-level harness for coding agents — file-level constraints that keep every agent true to your repo's structure. Node-friendly launcher for the Python engine.",
  "keywords": [
    "harness",
    "agent-harness",
    "coding-agent",
    "structure",
    "contract",
    "agents",
    "ai",
    "lint",
    "guardrails",
    "pre-commit"
  ],
  "license": "MIT",
  "bin": {
    "henxels": "bin/henxels.js"
  },
  "files": [
    "bin/henxels.js",
    "README.md"
  ],
  "engines": {
    "node": ">=14"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benquemax/henxels.git"
  }
}
