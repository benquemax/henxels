{
  "name": "henxels",
  "version": "0.8.0",
  "description": "A repo-level harness for coding agents — file-level constraints that keep every agent true to your repo's structure. No Python required: the launcher bootstraps its own engine (official uv, checksum-pinned) on first run.",
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../README.md','README.md')\""
  },
  "keywords": [
    "harness",
    "agent-harness",
    "coding-agent",
    "structure",
    "contract",
    "agents",
    "ai",
    "lint",
    "guardrails",
    "pre-commit",
    "llm-wiki",
    "okf",
    "open-knowledge-format",
    "knowledge-base",
    "agents-md"
  ],
  "license": "MIT",
  "bin": {
    "henxels": "bin/henxels.js"
  },
  "files": [
    "bin/henxels.js",
    "bin/bootstrap.cjs",
    "uv-manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benquemax/henxels.git"
  }
}
